    "text": "Dal duemilaventisette.",
    "start": 2.959,
    "end": 4.053
   },
   {
    "text": "Ma perché?",
    "start": 4.413,
    "end": 4.909
   },
   {
    "text": "Pensione di vecchiaia:",
    "start": 5.209,
    "end": 6.234
   },
   {
    "text": "sessantasette anni e un mese.",
    "start": 6.371,
    "end": 8.206
   },
   {
    "text": "La regola:",
    "start": 8.506,
    "end": 9.035
   },
   {
    "text": "se a sessantacinque anni si vive più a lungo, si va più tardi.",
    "start": 9.307,
    "end": 12.5
   },
   {
    "text": "Nel duemilaventotto, sessantasette",
    "start": 12.897,
    "end": 14.72
   },
   {
    "text": "e tre mesi.",
    "start": 14.845,
    "end": 15.676
   },
   {
    "text": "Per chi difende la regola,",
    "start": 15.976,
    "end": 17.144
   },
   {
    "text": "tiene in equilibrio i conti.",
    "start": 17.287,
    "end": 18.489
   },
   {
    "text": "Per la Cgil,",
    "start": 18.794,
    "end": 19.749
   },
   {
    "text": "allontana il traguardo di chi lavora.",
    "start": 19.915,
    "end": 21.635
   },
   {
    "text": "Poco o tanto,",
    "start": 21.935,
    "end": 22.768
   },
   {
    "text": "un mese conta.",
    "start": 22.955,
    "end": 23.794
   },
   {
    "text": "E tu:",
    "start": 24.188,
    "end": 24.526
   },
   {
    "text": "a che età pensi di andarci?",
    "start": 24.88,
    "end": 26.15
   }
  ]
 },
