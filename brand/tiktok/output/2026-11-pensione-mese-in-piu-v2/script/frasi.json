[
 {
  "text": "Sessantasette anni e un mese.",
  "start": 0.0,
  "end": 2.001
 },
 {
  "text": "Dal duemilaventisette,",
  "start": 2.368,
  "end": 3.688
 },
 {
  "text": "per raggiungere la pensione di vecchiaia, si dovrà lavorare un mese in più.",
  "start": 3.813,
  "end": 7.338
 },
 {
  "text": "Ma perché?",
  "start": 7.698,
  "end": 8.281
 },
 {
  "text": "Si vive più a lungo:",
  "start": 8.623,
  "end": 9.702
 },
 {
  "text": "l'età sale con la speranza di vita.",
  "start": 9.966,
  "end": 11.775
 },
 {
  "text": "Cosa puoi fare?",
  "start": 12.075,
  "end": 12.82
 },
 {
  "text": "Primo:",
  "start": 13.12,
  "end": 13.441
 },
 {
  "text": "controlla i contributi versati, nel tuo estratto conto Inps.",
  "start": 13.778,
  "end": 16.762
 },
 {
  "text": "Secondo:",
  "start": 17.153,
  "end": 17.707
 },
 {
  "text": "stima la tua pensione con il simulatore gratuito dell'Inps.",
  "start": 18.006,
  "end": 20.953
 },
 {
  "text": "Terzo:",
  "start": 21.253,
  "end": 21.643
 },
 {
  "text": "valuta un fondo pensione.",
  "start": 21.913,
  "end": 23.257
 },
 {
  "text": "Quello che versi si può dedurre dalle tasse.",
  "start": 23.582,
  "end": 25.693
 },
 {
  "text": "Prima inizi, meglio è.",
  "start": 26.07,
  "end": 27.409
 },
 {
  "text": "E tu,",
  "start": 27.709,
  "end": 28.074
 },
 {
  "text": "ci stai già pensando?",
  "start": 28.282,
  "end": 29.259
 }
]