 "subs": [
  {
   "t": 0.25,
   "text": "UN'EREDITÀ"
  },
  {
   "t": 1.036,
   "text": "DA *30 MILIARDI*."
  },
  {
   "t": 2.516,
   "text": "*OTTO* EREDI."
  },
  {
   "t": 3.686,
   "text": "E NESSUN ACCORDO."
  },
  {
   "t": 4.617,
   "text": "MA *PERCHÉ?*"
  },
  {
   "t": 5.771,
   "text": "*DELFIN* È LA CASSAFORTE"
  },
  {
   "t": 6.974,
   "text": "DI LEONARDO DEL VECCHIO,"
  },
  {
   "t": 8.306,
   "text": "IL FONDATORE DI *LUXOTTICA*."
  },
  {
   "t": 10.281,
   "text": "DENTRO C'È CIRCA"
  },
  {
   "t": 11.088,
   "text": "*UN TERZO*"
  },
  {
   "t": 11.573,
   "text": "DI ESSILORLUXOTTICA,"
  },
  {
   "t": 13.227,
   "text": "E QUOTE PESANTI"
  },
  {
   "t": 14.073,
   "text": "DI *MPS* E *GENERALI*."
  },
  {
   "t": 16.134,
   "text": "IL TESTAMENTO L'HA DIVISA"
  },
  {
   "t": 17.42,
   "text": "IN *OTTO PARTI* UGUALI."
  },
  {
   "t": 19.077,
   "text": "ORA UN FIGLIO,"
  },
  {
   "t": 20.123,
   "text": "LEONARDO MARIA,"
  },
  {
   "t": 20.857,
   "text": "OFFRE CIRCA *3,7 MILIARDI*"
  },
  {
   "t": 23.259,
   "text": "PER OGNI QUOTA."
  },
  {
   "t": 24.605,
   "text": "UNA BANCA, *CITI*,"
  },
  {
   "t": 25.995,
   "text": "SI È DETTA PRONTA"
  },
  {
   "t": 26.585,
   "text": "A PRESTARGLI"
  },
  {
   "t": 27.171,
   "text": "FINO A *22 MILIARDI*."
  },
  {
   "t": 29.011,
   "text": "UN MILIARDARIO"
  },
  {
   "t": 29.835,
   "text": "DELLA *REPUBBLICA CECA*,"
  },
  {
   "t": 31.606,
   "text": "INVECE, NE OFFRE"
  },
  {
   "t": 32.39,
   "text": "CIRCA *30* PER DELFIN."
  },
  {
   "t": 34.091,
   "text": "MA *QUATTRO SOCI*"
  },
  {
   "t": 34.838,
   "text": "HANNO DETTO NO."
  },
  {
   "t": 35.809,
   "text": "CIOÈ *METÀ* DI DELFIN."
  },
  {
   "t": 37.279,
   "text": "PER LEONARDO MARIA,"
  },
  {
   "t": 38.449,
   "text": "RIUNIRLA *IN UNA SOLA MANO*"
  },
  {
   "t": 39.813,
   "text": "SERVE A TENERLA *ITALIANA*."
  },
  {
   "t": 41.779,
   "text": "ALTRI SOCI HANNO PROPOSTO"
  },
  {
   "t": 43.178,
   "text": "DI TENERE ESSILORLUXOTTICA"
  },
  {
   "t": 44.888,
   "text": "E *DIVIDERSI* IL RESTO."
  },
  {
   "t": 46.715,
   "text": "E TU?"
  },
  {
   "t": 46.83,
   "text": "UN IMPERO COSÌ STA MEGLIO"
  },
  {
   "t": 48.204,
   "text": "IN *UNA MANO SOLA*,"
  },
  {
   "t": 49.216,
   "text": "O IN *TANTE*?"
  },
  {
   "t": 50.171,
   "text": "E CHI DOVREBBE"
  },
  {
   "t": 51.105,
   "text": "*DECIDERLO?*"
  }
 ],
