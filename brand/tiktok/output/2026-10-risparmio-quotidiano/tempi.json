  "frasi_originali": [
   {
    "text": "Se ti bevi un caffè al bar ogni giorno, spendi circa quattrocentosettanta euro all'anno",
    "start": 0.118,
    "end": 4.793
   },
   {
    "text": "e non te ne accorgi.",
    "start": 5.237,
    "end": 6.351
   },
   {
    "text": "Ma perché?",
    "start": 6.767,
    "end": 7.356
   },
   {
    "text": "Per Assoutenti un espresso costa in media uno e ventinove.",
    "start": 7.895,
    "end": 10.69
   },
   {
    "text": "Moltiplicato per trecentosessantacinque giorni:",
    "start": 11.006,
    "end": 13.444
   },
   {
    "text": "quattrocentosettantuno euro.",
    "start": 13.723,
    "end": 15.108
   },
   {
    "text": "Sono piccole spese.",
    "start": 15.68,
    "end": 16.717
   },
   {
    "text": "E le piccole spese non le guardiamo mai.",
    "start": 17.122,
    "end": 18.914
   },
   {
    "text": "Primo:",
    "start": 19.565,
    "end": 19.892
   },
   {
    "text": "controlla gli abbonamenti che non usi.",
    "start": 20.209,
    "end": 21.872
   },
   {
    "text": "Secondo:",
    "start": 22.367,
    "end": 22.945
   },
   {
    "text": "fai la lista prima di andare al supermercato.",
    "start": 23.18,
    "end": 25.3
   },
   {
    "text": "Terzo:",
    "start": 25.808,
    "end": 26.248
   },
   {
    "text": "confronta le offerte di luce e gas",
    "start": 26.528,
    "end": 28.306
   },
   {
    "text": "una volta all'anno.",
    "start": 28.41,
    "end": 29.313
   },
   {
    "text": "Non serve cambiare vita.",
    "start": 29.78,
    "end": 30.943
   },
   {
    "text": "Basta guardare le piccole spese.",
    "start": 31.273,
    "end": 32.829
   },
   {
    "text": "E tu:",
    "start": 33.319,
    "end": 33.655
   },
   {
    "text": "qual è quella che non guardi mai?",
    "start": 34.093,
    "end": 35.426
   }
  ],
