[
 {
  "text": "Un caffè al bar ogni giorno costa circa quattrocentosettanta",
  "start": 0.0,
  "end": 3.014
 },
 {
  "text": "euro all'anno.",
  "start": 3.097,
  "end": 4.127
 },
 {
  "text": "Ma perché non ce ne accorgiamo?",
  "start": 4.518,
  "end": 5.859
 },
 {
  "text": "Perché sono piccole spese,",
  "start": 6.361,
  "end": 7.675
 },
 {
  "text": "e le piccole spese non le guardiamo mai.",
  "start": 7.938,
  "end": 9.829
 },
 {
  "text": "Primo,",
  "start": 10.368,
  "end": 10.7
 },
 {
  "text": "controlla gli abbonamenti che non usi.",
  "start": 11.07,
  "end": 12.709
 },
 {
  "text": "Secondo,",
  "start": 13.11,
  "end": 13.723
 },
 {
  "text": "fai la lista prima di andare al supermercato.",
  "start": 13.923,
  "end": 16.099
 },
 {
  "text": "Terzo,",
  "start": 16.564,
  "end": 16.972
 },
 {
  "text": "confronta le offerte di luce e gas una volta all'anno.",
  "start": 17.229,
  "end": 20.028
 },
 {
  "text": "Non serve cambiare vita,",
  "start": 20.471,
  "end": 21.664
 },
 {
  "text": "basta iniziare a guardare le piccole spese.",
  "start": 21.929,
  "end": 23.858
 }
]