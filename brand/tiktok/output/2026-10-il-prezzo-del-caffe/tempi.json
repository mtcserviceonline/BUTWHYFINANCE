   "text": "IL CAFFÈ AL BAR"
  },
  {
   "t": 1.089,
   "text": "COSTA IL *24%* IN PIÙ"
  },
  {
   "t": 3.101,
   "text": "DI CINQUE ANNI FA."
  },
  {
   "t": 4.479,
   "text": "MA *PERCHÉ?*"
  },
  {
   "t": 5.583,
   "text": "NEL *2021* UNA TAZZINA"
  },
  {
   "t": 7.362,
   "text": "COSTAVA *1,04 EURO*."
  },
  {
   "t": 9.631,
   "text": "OGGI, IN MEDIA,"
  },
  {
   "t": 10.471,
   "text": "*1,29*."
  },
  {
   "t": 11.999,
   "text": "SONO *25 CENTESIMI* IN PIÙ."
  },
  {
   "t": 14.529,
   "text": "CHI *INCASSA*"
  },
  {
   "t": 15.19,
   "text": "QUESTA DIFFERENZA?"
  },
  {
   "t": 16.55,
   "text": "CI SONO *DUE* SPIEGAZIONI."
  },
  {
   "t": 18.532,
   "text": "PRIMA TESI:"
  },
  {
