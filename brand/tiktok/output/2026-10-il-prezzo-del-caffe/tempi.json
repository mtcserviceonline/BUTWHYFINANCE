   "text": "COSTA DI PIÙ"
  },
  {
   "t": 19.833,
   "text": "LA *MATERIA PRIMA*."
  },
  {
   "t": 20.98,
   "text": "L'ARABICA È SALITA"
  },
  {
   "t": 22.185,
   "text": "DELL'*80%*."
  },
  {
   "t": 23.766,
   "text": "MA LA TAZZINA"
  },
  {
   "t": 24.537,
   "text": "È SALITA SOLO"
  },
  {
   "t": 25.462,
   "text": "DEL *24%*."
  },
  {
   "t": 27.047,
   "text": "PER *ILLYCAFFÈ*,"
  },
  {
   "t": 27.972,
   "text": "PARTE DELL'AUMENTO"
  },
  {
   "t": 28.827,
   "text": "L'HANNO ASSORBITA *I BAR*."
  },
  {
   "t": 30.479,
   "text": "SECONDA TESI:"
  },
  {
   "t": 31.426,
   "text": "COSTA DI PIÙ"
  },
  {
   "t": 32.01,
   "text": "*GESTIRE* UN BAR."
  },
  {
   "t": 33.077,
   "text": "PER *ASSOUTENTI*"
  },
  {
   "t": 33.966,
   "text": "PESANO *ENERGIA*"
  },
  {
   "t": 34.856,
   "text": "E COSTI DI GESTIONE,"
  },
  {
   "t": 36.116,
   "text": "NON IL CAFFÈ."
  },
  {
   "t": 37.231,
   "text": "LE DUE COSE"
  },
  {
   "t": 37.824,
   "text": "POSSONO ESSERE *VERE INSIEME*."
  },
  {
   "t": 39.796,
   "text": "DIPENDE DA QUANTO *PESA*"
  },
  {
   "t": 41.073,
   "text": "OGNI VOCE"
  },
  {
   "t": 41.712,
   "text": "SUL CONTO DEL BAR."
  },
  {
   "t": 43.05,
   "text": "E OGGI IL CAFFÈ CRUDO"
  },
  {
   "t": 44.277,
   "text": "VALE *MENO*"
  },
  {
   "t": 44.89,
   "text": "DELLA MEDIA DEL *2025*."
  },
  {
   "t": 47.08,
   "text": "MA IL PREZZO"
  },
  {
   "t": 47.697,
   "text": "ALLA TAZZINA"
  },
  {
   "t": 48.468,
   "text": "POTREBBE *NON SEGUIRLO*"
  },
  {
   "t": 49.547,
   "text": "SUBITO."
  },
  {
   "t": 50.541,
   "text": "ALLA FINE,"
  },
  {
   "t": 51.294,
   "text": "*QUALCUNO PAGA*:"
  },
  {
   "t": 52.244,
   "text": "IL *CLIENTE*, IL *BAR*"
  },
  {
   "t": 53.063,
   "text": "O IL *TORREFATTORE*."
  },
  {
   "t": 54.804,
   "text": "E PER TE?"
